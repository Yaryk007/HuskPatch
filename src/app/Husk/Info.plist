<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).pairing.*</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).downloads.*</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).*</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- HuskPatch: no Liquid Glass. iOS 26 otherwise draws the back button, search and bars as glass, which no
	     setting can restyle into Material 3 (MaterialStyle.swift). -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>HuskPatch</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Android App</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.android.package-archive</string>
				<string>app.husk.xapk</string>
				<string>app.husk.apkm</string>
				<string>app.husk.apks</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>2.4.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>husk</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>120</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>stikjit</string>
		<string>stikdebug</string>
		<string>stosdebug</string>
		<string>apple-magnifier</string>
		<string>localdevvpn</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing-pairable-host._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>An Android app you run in HuskPatch asked for the camera, and you allowed it in Android's permission dialog.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>An Android app you run in HuskPatch asked for the microphone, and you allowed it in Android's permission dialog.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>An Android app you run in HuskPatch asked for your location, and you allowed it in Android's permission dialog.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>An Android app you run in HuskPatch asked for your photos and videos, and you allowed it in Android's permission dialog.</string>
	<key>NSContactsUsageDescription</key>
	<string>An Android app you run in HuskPatch asked for your contacts, and you allowed it in Android's permission dialog.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>An Android app you run in HuskPatch asked for your calendar, and you allowed it in Android's permission dialog.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>An Android app you run in HuskPatch asked for your calendar, and you allowed it in Android's permission dialog.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>An Android app you run in HuskPatch asked for nearby devices, and you allowed it in Android's permission dialog.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Husk uses the local network to pair with this iPhone for JIT, without a computer.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Android App</string>
			<key>UTTypeIdentifier</key>
			<string>com.android.package-archive</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apk</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.android.package-archive</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Android App Bundle (XAPK)</string>
			<key>UTTypeIdentifier</key>
			<string>app.husk.xapk</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>xapk</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Android App Bundle (APKM)</string>
			<key>UTTypeIdentifier</key>
			<string>app.husk.apkm</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apkm</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Android App Bundle (APKS)</string>
			<key>UTTypeIdentifier</key>
			<string>app.husk.apks</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apks</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
